\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces $\Delta $ hits@0.6 (\texttt  {marginal} $-$ \texttt  {edlm}), mean $\pm $ standard error over 5 seeds. Bold marks $|\Delta | > 2.5\,\mathrm  {se}$. The $\lambda =0$ column and the $k=1$ row are the two null controls. Every cell is 5 seeds; the follow-up seeds of Check~A are kept out of the grid on purpose (see text) and live in \texttt  {notes/fewstep\_all\_seeds.csv}.}}{3}{table.1}\protected@file@percent }
\newlabel{tab:fs-delta-hits}{{1}{3}{$\Delta $ hits@0.6 (\texttt {marginal} $-$ \texttt {edlm}), mean $\pm $ standard error over 5 seeds. Bold marks $|\Delta | > 2.5\,\mathrm {se}$. The $\lambda =0$ column and the $k=1$ row are the two null controls. Every cell is 5 seeds; the follow-up seeds of Check~A are kept out of the grid on purpose (see text) and live in \texttt {notes/fewstep\_all\_seeds.csv}}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces $\Delta $ hits@0.6 against $k$. $\lambda =0$ is the control panel; error bars are $\pm 1$ standard error over 5 seeds.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:fs-delta}{{1}{3}{$\Delta $ hits@0.6 against $k$. $\lambda =0$ is the control panel; error bars are $\pm 1$ standard error over 5 seeds}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}The trade-off few-step actually makes}{4}{section.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces $\lambda =200$, counts out of 2048 samples; columns 5--8 are \texttt  {marginal} and 9--12 are \texttt  {edlm}. \emph  {hits@0.6} is the number of \emph  {novel} molecules scoring $\mathrm  {QED}\ge 0.60$, the same quantity as in Table~\ref {tab:fs-delta-hits}; \emph  {valid} and \emph  {novel} are counts of the 2048 generated sequences, and \emph  {novel} is deduplicated ($\mathrm  {set(valid)}\setminus $ train). Reward evaluations per sequence are $N\times T$. The three factors multiply to hits@0.6, so each row shows where few-step gains and where it pays. The $k=16$ and $k=32$ rows exist only at $N=1000$: they were a follow-up once the factorial grid put that optimum on its boundary.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:fs-tradeoff}{{2}{4}{$\lambda =200$, counts out of 2048 samples; columns 5--8 are \texttt {marginal} and 9--12 are \texttt {edlm}. \emph {hits@0.6} is the number of \emph {novel} molecules scoring $\mathrm {QED}\ge 0.60$, the same quantity as in Table~\ref {tab:fs-delta-hits}; \emph {valid} and \emph {novel} are counts of the 2048 generated sequences, and \emph {novel} is deduplicated ($\mathrm {set(valid)}\setminus $ train). Reward evaluations per sequence are $N\times T$. The three factors multiply to hits@0.6, so each row shows where few-step gains and where it pays. The $k=16$ and $k=32$ rows exist only at $N=1000$: they were a follow-up once the factorial grid put that optimum on its boundary}{table.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Pushing $k$ further at $N=1000$}{5}{section.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces $N=1000$, $\lambda =200$, hits@0.6. $k=16$ and $32$ are a follow-up at this $N$ only. Absolute hits peak at $k=8$; hits per reward call keep rising to $k=32$.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:fs-extension}{{3}{5}{$N=1000$, $\lambda =200$, hits@0.6. $k=16$ and $32$ are a follow-up at this $N$ only. Absolute hits peak at $k=8$; hits per reward call keep rising to $k=32$}{table.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Hits per reward call: no $k=1$ point is on the frontier}{5}{section.6}\protected@file@percent }
