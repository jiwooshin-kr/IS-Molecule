\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces $\lambda $ at 150 steps, \textbf  {exact}, $N = 100$, 1024 samples. The 32-step column is the \texttt  {aggregate\_x0} grid at the same $N$ (Table \ref {tab:grid}), which is the only $\lambda $ series available at 32 steps.}}{13}{table.8}\protected@file@percent }
