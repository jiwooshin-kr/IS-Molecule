\@writefile{toc}{\contentsline {paragraph}{D-CBG's mean advantage is a lower-tail effect.}{8}{section*.16}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{At the top of the distribution the ordering reverses.}{8}{section*.17}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces QED distribution over the novel set, same runs as Table~\ref {tab:headline}. \emph  {Novel} and $>0.6$ are counts out of 1024 generated samples; \emph  {Top-20} is the mean of the 20 best novel molecules, so it is matched on generation budget rather than on novel count. \emph  {Max}$_{78}$ is the mean maximum of a random 78-molecule subsample (4000 draws, 78 = the smallest novel count in the table), which is the max column made comparable across rows --- the raw \emph  {Max} is not, since it grows with the novel count and the rows differ by $4.7\times $ in it. Bold marks the best value in each column at printed precision.}}{9}{table.5}\protected@file@percent }
\newlabel{tab:headline-dist}{{5}{9}{QED distribution over the novel set, same runs as Table~\ref {tab:headline}. \emph {Novel} and $>0.6$ are counts out of 1024 generated samples; \emph {Top-20} is the mean of the 20 best novel molecules, so it is matched on generation budget rather than on novel count. \emph {Max}$_{78}$ is the mean maximum of a random 78-molecule subsample (4000 draws, 78 = the smallest novel count in the table), which is the max column made comparable across rows --- the raw \emph {Max} is not, since it grows with the novel count and the rows differ by $4.7\times $ in it. Bold marks the best value in each column at printed precision}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Mean novel QED within each quartile bin, and the gap between the top and bottom bins (\emph  {Spread}). Guidance strength buys D-CBG its mean by shrinking the spread; ours preserves it.}}{10}{table.6}\protected@file@percent }
\newlabel{tab:headline-quartiles}{{6}{10}{Mean novel QED within each quartile bin, and the gap between the top and bottom bins (\emph {Spread}). Guidance strength buys D-CBG its mean by shrinking the spread; ours preserves it}{table.6}{}}
\@writefile{toc}{\contentsline {paragraph}{What this does and does not change.}{10}{section*.18}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Quality against novelty, all 19 configurations of Table~\ref {tab:headline}. Panel (a) uses the mean novel QED of that table: the front holds three points --- D-CBG exact $\gamma = 5$ and $\gamma = 2$, and our \textbf  {exact} $N{=}500$ --- so on the mean neither method dominates and the choice is a genuine trade-off; note that D-CBG exact $\gamma = 1$ and the whole approximate branch are dominated by our rows. Panel (b) replaces the mean with the budget-matched top-20 mean and the picture changes: the front is entirely ours, every D-CBG configuration is strictly dominated, and $10$ of our $12$ configurations beat $\gamma = 5$ on \emph  {both} axes at once (the remaining two match its top-20 to within $0.003$ with $3.2$--$3.5\times $ the novel count).}}{11}{figure.1}\protected@file@percent }
\newlabel{fig:pareto}{{1}{11}{Quality against novelty, all 19 configurations of Table~\ref {tab:headline}. Panel (a) uses the mean novel QED of that table: the front holds three points --- D-CBG exact $\gamma = 5$ and $\gamma = 2$, and our \textbf {exact} $N{=}500$ --- so on the mean neither method dominates and the choice is a genuine trade-off; note that D-CBG exact $\gamma = 1$ and the whole approximate branch are dominated by our rows. Panel (b) replaces the mean with the budget-matched top-20 mean and the picture changes: the front is entirely ours, every D-CBG configuration is strictly dominated, and $10$ of our $12$ configurations beat $\gamma = 5$ on \emph {both} axes at once (the remaining two match its top-20 to within $0.003$ with $3.2$--$3.5\times $ the novel count)}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}Denoising steps: 32 against 150}{11}{section.7}\protected@file@percent }
\newlabel{sec:steps}{{7}{11}{Denoising steps: 32 against 150}{section.7}{}}
\@writefile{toc}{\contentsline {paragraph}{More steps buy validity we did not need and give up the throughput advantage.}{11}{section*.19}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Novel QED distributions behind the two means, exact variants only, one dot per novel molecule. Increasing $\gamma $ (orange) concentrates the distribution into a band below $0.6$ and shrinks the novel count; increasing $N$ (blue) shifts the distribution up while keeping its spread, so the count above $0.6$ grows from 42 to 81 even though the mean stays lower.}}{12}{figure.2}\protected@file@percent }
\newlabel{fig:dist}{{2}{12}{Novel QED distributions behind the two means, exact variants only, one dot per novel molecule. Increasing $\gamma $ (orange) concentrates the distribution into a band below $0.6$ and shrinks the novel count; increasing $N$ (blue) shifts the distribution up while keeping its spread, so the count above $0.6$ grows from 42 to 81 even though the mean stays lower}{figure.2}{}}
\@writefile{toc}{\contentsline {paragraph}{The effect is specific to the guided sampler.}{12}{section*.20}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The exact-versus-marginal ordering washes out.}{12}{section*.21}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The $\lambda $ curve saturates far earlier at 150 steps.}{12}{section*.22}\protected@file@percent }
